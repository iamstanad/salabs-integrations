        1040,
        520
      ],
      "parameters": {
        "modelName": "models/gemini-2.5-flash",
        "options": {}
      }
    },
    {
      "id": "4049aa55-5aac-5816-bfde-deef6f5dfad9",
      "name": "Make the row",
      "type": "n8n-nodes-base.set",
