              "value": "={{ $('Scrape page').item.json.metadata.url }}"
            },
            {
              "id": "b29e20cb-9cf2-5346-b22d-d00d061c1393",
              "name": "Title",
              "type": "string",
              "value": "={{ $('Scrape page').item.json.metadata.title }}"
