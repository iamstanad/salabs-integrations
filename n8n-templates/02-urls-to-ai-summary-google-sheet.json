          "markdown"
        ],
        "scrapeOptions": {
          "onlyMainContent": true
        }
      }
    },
    {
      "id": "fcccaa99-5a0c-509f-bea7-6fbde7a44940",
      "name": "Summarise",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        1040,
        300
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Summarise this web page in 3 short bullet points for a busy reader. Plain text, no intro.\n\nTitle: {{ $json.metadata.title }}\n\n{{ $json.markdown.slice(0, 20000) }}",
        "batching": {}
      }
    },
    {
      "id": "602d1a56-99ab-5c8c-82d6-778b6bb01e77",
      "name": "Gemini",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
