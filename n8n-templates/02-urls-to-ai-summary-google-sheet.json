            {
              "id": "4332b5c9-5aae-56f3-96f9-200121165894",
              "name": "Summary",
              "type": "string",
              "value": "={{ $json.text }}"
            },
            {
              "id": "f7568fca-a16e-503e-bec7-25d66ece7adb",
